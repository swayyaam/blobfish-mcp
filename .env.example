# Copy this file to .env and fill in your values

# Global Bearer token — used for all API requests unless overridden per-API
API_KEY=

# Request timeout in milliseconds (default: 30000)
BLOBFISH_TIMEOUT=

# Retry attempts on 5xx errors (default: 3)
BLOBFISH_RETRIES=

# Response cache TTL in seconds (default: 60, set to 0 to disable)
BLOBFISH_CACHE_TTL=

# Log file path, or "true" to log to ./blobfish.log
BLOBFISH_LOG=

# Port for --http / --sse transport modes (default: 3000)
BLOBFISH_PORT=

# Environment profile — same as passing --profile (e.g. "staging" loads blobfish.staging.json
# if present and selects auth_profiles.staging on each API entry)
BLOBFISH_PROFILE=

# Set to "true" to allow loading specs from local file paths (disabled by default for security)
BLOBFISH_ALLOW_LOCAL=

# Directory to restrict local file access to (default: project root)
BLOBFISH_LOCAL_DIR=
