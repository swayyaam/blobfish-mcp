{
  "timeout": 30000,
  "retries": 3,
  "apis": [
    {
      "url": "https://petstore.swagger.io/v2/swagger.json",
      "name": "petstore"
    },
    {
      "url": "https://api.example.com/openapi.json",
      "name": "myapi",
      "auth": {
        "type": "bearer",
        "key": "${MY_API_TOKEN}"
      },
      "timeout": 10000
    },
    {
      "url": "https://api.example.com/openapi.json",
      "name": "myapi_apikey",
      "auth": {
        "type": "apikey",
        "key": "${MY_API_KEY}",
        "header": "X-Api-Key"
      }
    },
    {
      "url": "https://api.github.com/openapi.json",
      "name": "github",
      "include_tags": ["repos", "issues", "pulls"],
      "auth": {
        "type": "bearer",
        "key": "${GITHUB_TOKEN}"
      }
    },
    {
      "url": "./local-spec.json",
      "name": "localapi",
      "mock": true,
      "shallow": true
    }
  ]
}
