{
  "name": "blobfish-mcp",
  "version": "1.3.0",
  "description": "Any OpenAPI spec. Zero config. Claude-ready. MCP server that turns any REST API into Claude-callable tools instantly.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "blobfish": "./server.js",
    "blobfish-mcp": "./server.js"
  },
  "files": [
    "server.js",
    "setup.js",
    "src/",
    "registry/",
    "workflows/",
    "assets/",
    "smithery.yaml",
    ".env.example",
    "blobfish.example.json"
  ],
  "scripts": {
    "start": "node --env-file=.env server.js",
    "setup": "node setup.js",
    "test": "node --test test/basic.test.js"
  },
  "keywords": [
    "mcp",
    "openapi",
    "swagger",
    "claude",
    "ai",
    "llm",
    "api",
