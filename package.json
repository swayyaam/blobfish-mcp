  "license": "MIT",
  "homepage": "https://github.com/swayyaam/blobfish-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swayyaam/blobfish-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/swayyaam/blobfish-mcp/issues"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
